{
  "name": "@yfwu2020/dsh-selection-explain",
  "version": "0.11.1",
  "description": "DSH 划词解读：选中文字浮出按钮，点击弹窗流式显示专业中英翻译 + 该文字在当前上下文中的含义详解",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "native/mic-probe.c",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yfwu2020/dsh-selection-explain.git"
  },
  "homepage": "https://github.com/yfwu2020/dsh-selection-explain#readme",
  "bugs": {
    "url": "https://github.com/yfwu2020/dsh-selection-explain/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.5-rc <2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc <2",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc <2",
    "@deepseek-ai/schemastery": ">=3.18 <4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "22.14.0",
    "typescript": "5.9.3",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "prepack": "npm run build",
    "typecheck": "npm run typecheck:host && npm run typecheck:client",
    "typecheck:host": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.mjs all",
    "test:unit": "npm run build && node scripts/run-tests.mjs unit",
    "test:integration": "npm run build && node scripts/run-tests.mjs integration",
    "test:browser": "npm run build && node scripts/run-tests.mjs browser",
    "test:online": "npm run build && node scripts/run-tests.mjs online",
    "test:effort": "npm run build && node tests/unit/effort-retry.test.mjs",
    "test:effort-map": "npm run build && node tests/unit/effort-map.test.mjs",
    "test:transcript": "npm run build && node tests/unit/transcript.test.mjs",
    "test:guard": "npm run build && node tests/unit/guard.test.mjs",
    "test:format": "npm run build && node tests/unit/format.test.mjs",
    "test:bridge": "npm run build && node tests/unit/bridge.test.mjs",
    "test:smoke": "npm run build && node tests/browser/bridge.test.mjs",
    "test:panel": "npm run build && node tests/browser/panel.test.mjs",
    "test:prompt": "npm run build && node tests/unit/prompt.test.mjs",
    "test:speech": "npm run build && node tests/unit/speech.test.mjs",
    "test:voice": "npm run build && node tests/browser/voice.test.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
